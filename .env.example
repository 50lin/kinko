# ───────── Kinkō · variables de entorno (copia a apps/api/.env) ─────────
NODE_ENV=development
PORT=4000
PUBLIC_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,capacitor://localhost,https://localhost,http://localhost

# Base de datos. Vacío = base de datos local en archivo (.data/kinko-dev.json), perfecta para probar.
# Producción: MongoDB Atlas en región UE (Fráncfort/Irlanda/París) con cifrado y backups.
MONGODB_URI=
MONGODB_DB=kinko

# Secretos (obligatorios en producción). Generar con:  openssl rand -base64 48  /  openssl rand -base64 32
JWT_SECRET=
DATA_ENCRYPTION_KEY=
# Rotación de claves: la primera cifra, todas descifran →  DATA_ENCRYPTION_KEYS=k2:BASE64,k1:BASE64
DATA_ENCRYPTION_KEYS=

# Demo y seguridad
DEMO_MODE=true            # cuentas de demo con un clic (desactivar en producción)
SEED_DEMO=true            # carga datos ficticios al arrancar si la base está vacía
REQUIRE_2FA_STAFF=false   # true en producción: 2FA obligatoria para profesionales y admins
COOKIE_SECURE=false       # true detrás de HTTPS
TRUST_PROXY=false
MINOR_CONSENT_AGE=16      # LOPDGDD art. 7 (14 en la ley; usamos 16 por prudencia)
K_ANONYMITY=10
DP_EPSILON=1

# IA de acompañamiento (Kio). Sin clave funciona el motor local sin conexión.
ANTHROPIC_API_KEY=
AI_MODEL_MAIN=claude-sonnet-5-5
AI_MODEL_LIGHT=claude-haiku-5-5

# Pagos (sin clave = pagos simulados)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Videollamada: servidor TURN para redes corporativas/4G (p. ej. Twilio, Xirsys o coturn propio)
TURN_URL=
TURN_USERNAME=
TURN_PASSWORD=

# Archivos subidos (en producción: bucket S3 compatible en la UE)
UPLOADS_DIR=
# Web compilada que sirve la API en producción
WEB_DIST=../web/dist
